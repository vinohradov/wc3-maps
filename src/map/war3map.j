function ph takes nothing returns nothing
local unit u
set u=GetTriggerUnit()
call GroupRemoveUnit(Z,GetTriggerUnit())
set T=GetUnitLoc(u)
call AddSpecialEffectLocBJ(T,"Abilities\\Spells\\Orc\\MirrorImage\\MirrorImageCaster.mdl")
call DestroyEffect(bj_lastCreatedEffect)
call eN(.3)
if((GetUnitTypeId(u)=='h07D'))then
set u=ReplaceUnitBJ(u,Go[GetRandomInt(1,ho[1])],3)
set Ev=GetUnitPointValue(bj_lastReplacedUnit)
endif
if((GetUnitTypeId(u)=='h07E'))then
set u=ReplaceUnitBJ(u,Ho[GetRandomInt(1,ho[2])],3)
endif
if((GetUnitTypeId(u)=='h07G'))then
set u=ReplaceUnitBJ(u,jo[GetRandomInt(1,ho[3])],3)
endif
if((GetUnitTypeId(u)=='h07F'))then
set u=ReplaceUnitBJ(u,Jo[GetRandomInt(1,ho[4])],3)
endif
if((GetUnitTypeId(u)=='h07H'))then
set u=ReplaceUnitBJ(u,ko[GetRandomInt(1,ho[5])],3)
endif
if((GetUnitTypeId(u)=='h07I'))then
set u=ReplaceUnitBJ(u,Ko[GetRandomInt(1,ho[6])],3)
endif
set u=bj_lastReplacedUnit
call GroupAddUnit(Z,bj_lastReplacedUnit)
set K=GetUnitPointValue(GetTriggerUnit())
call SetPlayerStateBJ(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_GOLD_GATHERED,(GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_GOLD_GATHERED)-K))
set Ev=GetUnitPointValue(bj_lastReplacedUnit)
call SetPlayerStateBJ(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_GOLD_GATHERED,(GetPlayerState(GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_GOLD_GATHERED)+Ev))
if(K>Ev)then
set Xv=K-Ev
call Ab(GetTriggerUnit(),"- "+I2S(Xv),100.,.0,.0,GetOwningPlayer(GetTriggerUnit()))
set Br[(1+GetPlayerId(GetOwningPlayer(GetTriggerUnit())))]=(Br[(1+GetPlayerId(GetOwningPlayer(GetTriggerUnit())))]-Xv)
endif
if(K<Ev)then
set Xv=Ev-K
call Ab(GetTriggerUnit(),"+ "+I2S(Xv),100.,77.,.0,GetOwningPlayer(GetTriggerUnit()))
set Br[(1+GetPlayerId(GetOwningPlayer(GetTriggerUnit())))]=(Br[(1+GetPlayerId(GetOwningPlayer(GetTriggerUnit())))]+Xv)
endif
call SetUnitVertexColorBJ(u,'d','d','d',50.)
call SetUnitTimeScalePercent(u,.0)
call ResetUnitAnimation(u)
if((GetUnitTypeId(u)=='h05N'))then
call SetUnitTimeScalePercent(u,100.)
call eN(.3)
call SetUnitTimeScalePercent(u,.0)
call ResetUnitAnimation(u)
endif
set u=null
call TriggerExecute(CE)
endfunction
