function cH takes nothing returns nothing
local effect Eh
if(BH())then
set Y=GetSpellAbilityUnit()
set bj_forLoopBIndex=1
set bj_forLoopBIndexEnd=Rv
loop
exitwhen bj_forLoopBIndex>bj_forLoopBIndexEnd
if(bH())then
set T=GetUnitLoc(Y)
if(AH())then
set K=(GetUnitPointValue(GetTriggerUnit())*1)
else
if(IH())then
set K=R2I((I2R(GetUnitPointValue(GetTriggerUnit()))*.9))
else
if(OH())then
set K=R2I((I2R(GetUnitPointValue(GetTriggerUnit()))*.9))
else
set K=R2I((I2R(GetUnitPointValue(GetTriggerUnit()))*qv))
endif
endif
endif
call DisplayTimedTextToForce(FN(GetOwningPlayer(GetSpellAbilityUnit())),7.,(("|cffC0C0C0You sold a|r "+(GetUnitName(Y)+" |cffC0C0C0for|r |cffFFcc00"))+(I2S(K)+"|r |cffC0C0C0gold.|r")))
call AdjustPlayerStateBJ(K,GetOwningPlayer(Y),PLAYER_STATE_RESOURCE_GOLD)
call SetPlayerStateBJ(GetOwningPlayer(Y),PLAYER_STATE_GOLD_GATHERED,(GetPlayerState(GetOwningPlayer(Y),PLAYER_STATE_GOLD_GATHERED)-K))
set Ev=GetUnitPointValue(Y)
