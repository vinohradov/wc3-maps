call SetPlayerStateBJ(GetOwningPlayer(Y),PLAYER_STATE_GOLD_GATHERED,(GetPlayerState(GetOwningPlayer(Y),PLAYER_STATE_GOLD_GATHERED)-Xv))
set Br[(1+GetPlayerId(GetOwningPlayer(Y)))]=(Br[(1+GetPlayerId(GetOwningPlayer(Y)))]-Xv)
set nv=GetOwningPlayer(GetSpellAbilityUnit())
if(NH())then
call Ab(GetSpellAbilityUnit(),"+"+I2S(K),100.,77.,.0,nv)
endif
call GroupRemoveUnit(M[(1+GetPlayerId(GetOwningPlayer(Y)))],Y)
call GroupRemoveUnit(Z,Y)
call RemoveUnit(Y)
call TriggerExecute(CE)
call AddSpecialEffectLocBJ(T,"Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl")
set Eh=bj_lastCreatedEffect
call RemoveLocation(T)
endif
set bj_forLoopBIndex=bj_forLoopBIndex+1
endloop
call DestroyEffect(Eh)
else
call DisplayTimedTextToForce(FN(GetOwningPlayer(GetSpellAbilityUnit())),7.,"TRIGSTR_4286")
endif
