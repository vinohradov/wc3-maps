function uN takes string UN returns nothing
local string wN=I2S(I)
set I=I+1
call StoreInteger(R,"val:"+wN,UN,I)
call StoreInteger(R,"chk:"+wN,wN,I)
call SyncStoredInteger(R,"val:"+wN,UN)
call SyncStoredInteger(R,"chk:"+wN,wN)
call FlushStoredInteger(R,"val:"+wN,UN)
call FlushStoredInteger(R,"chk:"+wN,wN)
endfunction
function rb takes nothing returns nothing
local integer i
local trigger t
set O=true
call uN("init version "+I2S(1)+" "+I2S(1))
set i=0
loop
exitwhen i>=$C
if GetPlayerController(Player(i))==MAP_CONTROL_USER and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING then
call uN("init pid "+I2S(i)+" "+SN(GetPlayerName(Player(i))))
endif
set i=i+1
endloop
endfunction
