local integer array pb
local boolean array Pb
set Pb[0]=true
set Pb[50]=true
set Pb[60]=true
set Pb[70]=true
set Pb[80]=true
set Pb[90]=true
set Pb['d']=true
set i=0
set j=0
loop
if Pb[j]then
set j=j+1
endif
exitwhen j>=256
set pb[j]=i
set i=i+1
set j=j+1
endloop
set i=0
