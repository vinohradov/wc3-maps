function fb takes string Fb returns string
local integer a=1
local integer b=StringLength(Fb)
local string gb=""
loop
exitwhen a>b
if(SubString(Fb,a,a+1)!="0" or SubString(Fb,a-1,a)!=",")then
if(SubString(Fb,a,a+1)==",")then
set gb=gb+", "
else
set gb=gb+SubString(Fb,a,a+1)
endif
endif
set a=a+1
endloop
return gb
endfunction
