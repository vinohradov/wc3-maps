// Reforged: summons are blocked on these levels unless mode "sa" is on
function Reforged_IsNoSendWave takes integer lvl returns boolean
if Reforged_SendAlways then
return false
endif
return lvl==1 or lvl==10 or lvl==20 or lvl==30
endfunction
// Reforged: shop versions per level.
// Barracks: h05C (<20) / Legendary h9B0 (>=20); on no-send levels their locked twins h9B1 / h9B2 (max stock 0).
// Advanced Barracks (Vr[1..8]): h05D (<10, already all locked) / h0AZ (10-14) / h0B0 (15+); locked -> h05D.
function Reforged_IsBarracks takes nothing returns boolean
local integer t=GetUnitTypeId(GetFilterUnit())
return t=='h05C' or t=='h9B0' or t=='h9B1' or t=='h9B2'
endfunction
function Reforged_BarracksTarget takes nothing returns integer
local boolean locked=Reforged_IsNoSendWave(L+1)
if L>=20 then
if locked then
return 'h9B2'
endif
return 'h9B0'
endif
if locked then
return 'h9B1'
endif
return 'h05C'
endfunction
function Reforged_AdvancedTarget takes nothing returns integer
if Reforged_IsNoSendWave(L+1) or L<10 then
return 'h05D'
elseif L<15 then
return 'h0AZ'
endif
return 'h0B0'
endfunction
function Reforged_ReplaceBarracks takes nothing returns nothing
local integer t=Reforged_BarracksTarget()
if GetUnitTypeId(GetEnumUnit())!=t then
call ReplaceUnitBJ(GetEnumUnit(),t,bj_UNIT_STATE_METHOD_RELATIVE)
endif
endfunction
function Reforged_UpdateShops takes nothing returns nothing
local group g=CreateGroup()
local integer i=1
local integer t=Reforged_AdvancedTarget()
call GroupEnumUnitsInRect(g,bj_mapInitialPlayableArea,Filter(function Reforged_IsBarracks))
call ForGroup(g,function Reforged_ReplaceBarracks)
call DestroyGroup(g)
set g=null
loop
exitwhen i>8
if Vr[i]!=null and GetUnitTypeId(Vr[i])!=t then
call ReplaceUnitBJ(Vr[i],t,bj_UNIT_STATE_METHOD_RELATIVE)
set Vr[i]=bj_lastReplacedUnit
endif
set i=i+1
endloop
if L>=20 and not Reforged_BarracksSwapped then
set Reforged_BarracksSwapped=true
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,15.,"|cffFFcc00Legendary Barracks|r are open: Pit Lord, Faceless One, Anub'arak, Nether Dragon, Eredar Warlock and Mannoroth can be summoned from level 21.")
endif
if Reforged_IsNoSendWave(L+1) and L>0 then
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,10.,"|cffFF0000Summons are locked for level "+I2S(L+1)+".|r")
endif
endfunction
function eN takes real xN returns nothing
local real oN
local real st=TimerGetElapsed(UA)
if st<=0 then
set UA=CreateTimer()
call TimerStart(UA,$F4240,false,null)
endif
if(xN>0)then
loop
set oN=xN-TimerGetElapsed(UA)+st
exitwhen oN<=0
if(oN>bj_POLLED_WAIT_SKIP_THRESHOLD)then
call TriggerSleepAction(.1*oN)
else
call TriggerSleepAction(bj_POLLED_WAIT_INTERVAL)
endif
endloop
endif
endfunction
function rN takes location iN,real aN,real nN returns location
return Location(GetLocationX(iN)+aN*Cos(nN*bj_DEGTORAD),GetLocationY(iN)+aN*Sin(nN*bj_DEGTORAD))
endfunction
function VN takes nothing returns boolean
local real dx=GetDestructableX(GetFilterDestructable())-WA
local real dy=GetDestructableY(GetFilterDestructable())-yA
return(dx*dx+dy*dy<=bj_enumDestructableRadius)
endfunction
function EN takes rect r,boolexpr XN returns group
set YA=CreateGroup()
call GroupEnumUnitsInRect(YA,r,XN)
call DestroyBoolExpr(XN)
return YA
endfunction
function ON takes rect r returns group
set YA=CreateGroup()
call GroupEnumUnitsInRect(YA,r,ZA)
return YA
endfunction
function RN takes rect r,player IN returns group
set YA=CreateGroup()
set bj_groupEnumOwningPlayer=IN
call GroupEnumUnitsInRect(YA,r,filterGetUnitsInRectOfPlayer)
return YA
endfunction
function AN takes real NN,location bN,boolexpr XN returns group
set YA=CreateGroup()
call GroupEnumUnitsInRangeOfLoc(YA,bN,NN,XN)
return YA
endfunction
function BN takes real NN,location bN returns group
set YA=CreateGroup()
call GroupEnumUnitsInRangeOfLoc(YA,bN,NN,ZA)
return YA
endfunction
function cN takes integer CN returns group
set YA=CreateGroup()
call GroupEnumUnitsOfType(YA,UnitId2String(CN),ZA)
return YA
endfunction
function dN takes player IN,boolexpr XN returns group
set YA=CreateGroup()
call GroupEnumUnitsOfPlayer(YA,IN,XN)
call DestroyBoolExpr(XN)
return YA
endfunction
function DN takes player IN returns group
set YA=CreateGroup()
call GroupEnumUnitsOfPlayer(YA,IN,ZA)
return YA
endfunction
function fN takes player IN,integer CN returns group
set YA=CreateGroup()
set bj_groupEnumTypeId=CN
call GroupEnumUnitsOfPlayer(YA,IN,filterGetUnitsOfPlayerAndTypeId)
return YA
endfunction
function FN takes player IN returns force
set zA=CreateForce()
call ForceAddPlayer(zA,IN)
return zA
endfunction
function gN takes player IN returns force
set zA=CreateForce()
call ForceEnumAllies(zA,IN,ZA)
return zA
endfunction
function GN takes player IN returns force
set zA=CreateForce()
call ForceEnumEnemies(zA,IN,ZA)
return zA
endfunction
function hN takes boolexpr XN returns force
set zA=CreateForce()
call ForceEnumPlayers(zA,XN)
call DestroyBoolExpr(XN)
return zA
endfunction
function HN takes itemtype jN,integer JN returns nothing
local group g
set bj_stockPickedItemType=jN
set bj_stockPickedItemLevel=JN
set g=CreateGroup()
call GroupEnumUnitsOfType(g,"marketplace",ZA)
call ForGroup(g,function UpdateEachStockBuildingEnum)
call DestroyGroup(g)
set g=null
endfunction
function kN takes nothing returns nothing
local integer pickedItemId
local itemtype KN
local integer lN=0
local integer LN=0
local integer JN
set JN=1
loop
if(bj_stockAllowedPermanent[JN])then
set LN=LN+1
if(GetRandomInt(1,LN)==1)then
set KN=ITEM_TYPE_PERMANENT
set lN=JN
endif
endif
if(bj_stockAllowedCharged[JN])then
set LN=LN+1
if(GetRandomInt(1,LN)==1)then
set KN=ITEM_TYPE_CHARGED
set lN=JN
endif
endif
if(bj_stockAllowedArtifact[JN])then
set LN=LN+1
if(GetRandomInt(1,LN)==1)then
set KN=ITEM_TYPE_ARTIFACT
set lN=JN
endif
endif
set JN=JN+1
exitwhen JN>$A
endloop
if(LN==0)then
set KN=null
return
endif
call HN(KN,lN)
set KN=null
endfunction
function mN takes nothing returns nothing
call kN()
call TimerStart(bj_stockUpdateTimer,bj_STOCK_RESTOCK_INTERVAL,true,function kN)
endfunction
function pN takes nothing returns boolean
return true
endfunction
function MMD__prepC2I takes nothing returns nothing
local integer i=0
local string id
loop
exitwhen i>=e
set id=SubString("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-+= \\!@#$%^&*()/?>.<,;:'\"{}[]|`~",i,i+1)
if id==StringCase(id,true)then
set id=id+"U"
endif
call StoreInteger(R,"c2i",id,i)
set i=i+1
endloop
endfunction
function SN takes string tN returns string
local integer j
local integer i=0
local string TN=""
local string c
loop
exitwhen i>=StringLength(tN)
set c=SubString(tN,i,i+1)
set j=0
loop
exitwhen j>=StringLength(" \\")
if c==SubString(" \\",j,j+1)then
set c="\\"+c
exitwhen true
endif
set j=j+1
endloop
set TN=TN+c
set i=i+1
endloop
return TN
endfunction
function MMD__emitter takes nothing returns player
local integer i=GetPlayerId(A)
loop
exitwhen i>=$A
if(GetPlayerController(A)==MAP_CONTROL_USER and GetPlayerSlotState(A)==PLAYER_SLOT_STATE_PLAYING)then
set A=Player(i)
endif
set i=i+1
endloop
return A
endfunction
function MMD__update_player takes nothing returns nothing
local boolean b=false
set bj_forLoopAIndex=1
